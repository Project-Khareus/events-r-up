{
  "name": "Notify Slack of Social Publications",
  "description": "Posts vendor publication results to the social_videos Slack channel.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "SocialAnnouncement",
      "events": [
        "update"
      ]
    },
    "condition": "${ (.trigger.data.status == \"published\" or .trigger.data.status == \"partially_published\") and .trigger.old_data.status == \"draft\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_slack_social_publications",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_slack": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifySocialPublication",
            "args": {
              "announcement_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify Slack",
            "description": "Share the vendor and publication results"
          }
        }
      }
    ]
  }
}