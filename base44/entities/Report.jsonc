{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string",
      "description": "ID of the user filing the report"
    },
    "reporter_email": {
      "type": "string",
      "description": "Email of the reporter"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "vendor",
        "event"
      ],
      "description": "Whether reporting a vendor or event"
    },
    "target_id": {
      "type": "string",
      "description": "ID of the vendor or event being reported"
    },
    "target_name": {
      "type": "string",
      "description": "Name of the vendor or event for easy reference"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Fraudulent or scam activity",
          "Misleading information",
          "Inappropriate content",
          "Harassment or abusive behavior",
          "Fake reviews or ratings",
          "Spam or unsolicited advertising",
          "Intellectual property violation",
          "Unsafe or illegal services",
          "Non-delivery of services",
          "Other"
        ]
      },
      "description": "Selected report reasons"
    },
    "details": {
      "type": "string",
      "description": "Additional details from the reporter"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of uploaded evidence files"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "resolved",
        "dismissed"
      ],
      "default": "pending",
      "description": "Admin review status"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes from admin review"
    }
  },
  "required": [
    "reporter_id",
    "target_type",
    "target_id",
    "reasons"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "reporter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}