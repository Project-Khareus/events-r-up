{
  "name": "Favorite",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who favorited"
    },
    "event_id": {
      "type": "string",
      "description": "Event being favorited (optional)"
    },
    "vendor_id": {
      "type": "string",
      "description": "Vendor being favorited (optional)"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "event",
        "vendor"
      ],
      "description": "Type of item favorited"
    }
  },
  "required": [
    "user_id",
    "item_type"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}