{
  "name": "VendorAnalytics",
  "type": "object",
  "properties": {
    "vendor_id": {
      "type": "string",
      "description": "ID of the vendor"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the metric"
    },
    "profile_views": {
      "type": "number",
      "default": 0,
      "description": "Number of profile views on this date"
    },
    "total_bookings": {
      "type": "number",
      "default": 0,
      "description": "Total booking requests"
    },
    "confirmed_bookings": {
      "type": "number",
      "default": 0,
      "description": "Number of confirmed bookings"
    },
    "revenue": {
      "type": "number",
      "default": 0,
      "description": "Revenue earned on this date"
    }
  },
  "required": [
    "vendor_id",
    "date"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.vendor_id": {
            "$in": {
              "$query": {
                "entity": "Vendor",
                "field": "id",
                "filter": {
                  "data.user_id": "{{user.id}}"
                }
              }
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}