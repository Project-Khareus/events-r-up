{
  "name": "Booking",
  "type": "object",
  "properties": {
    "vendor_id": {
      "type": "string",
      "description": "ID of the vendor being booked"
    },
    "vendor_name": {
      "type": "string",
      "description": "Name of the vendor for easy display"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user making the booking"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the user for easy display"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the event"
    },
    "guest_count": {
      "type": "number",
      "description": "Number of guests expected"
    },
    "message": {
      "type": "string",
      "description": "Additional details or special requests"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "quoted",
        "confirmed",
        "declined",
        "completed"
      ],
      "default": "pending",
      "description": "Booking request status. \"quoted\" means the vendor has sent a price for a quote request."
    },
    "request_type": {
      "type": "string",
      "enum": [
        "booking",
        "quote"
      ],
      "default": "booking",
      "description": "A direct booking request or a request for a price quote"
    },
    "vendor_user_id": {
      "type": "string",
      "description": "User ID of the vendor account, so the vendor can see and answer this request"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "weddings",
        "parties",
        "conference",
        "funeral",
        "other"
      ],
      "description": "Type of event (quote requests)"
    },
    "location": {
      "type": "string",
      "description": "Where the event will take place (quote requests)"
    },
    "budget_min": {
      "type": "number",
      "description": "Lowest budget the customer has in mind"
    },
    "budget_max": {
      "type": "number",
      "description": "Highest budget the customer has in mind"
    },
    "budget_currency": {
      "type": "string",
      "default": "GHS",
      "description": "Currency for the budget, e.g. GHS"
    },
    "contact_phone": {
      "type": "string",
      "description": "Phone or WhatsApp number the customer can be reached on"
    },
    "quote_amount": {
      "type": "number",
      "description": "Price the vendor quoted"
    },
    "quote_currency": {
      "type": "string",
      "description": "Currency of the quoted price"
    },
    "vendor_note": {
      "type": "string",
      "description": "Vendor message sent with the quote"
    }
  },
  "required": [
    "vendor_id",
    "user_id",
    "event_date",
    "guest_count"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.vendor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.vendor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
