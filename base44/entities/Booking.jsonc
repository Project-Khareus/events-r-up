{
  "name": "Booking",
  "type": "object",
  "properties": {
    "vendor_id": {
      "type": "string",
      "description": "ID of the vendor being booked"
    },
    "vendor_name": {
      "type": "string",
      "description": "Name of the vendor for easy display"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user making the booking"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the user for easy display"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the event"
    },
    "guest_count": {
      "type": "number",
      "description": "Number of guests expected"
    },
    "message": {
      "type": "string",
      "description": "Additional details or special requests"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "declined",
        "completed"
      ],
      "default": "pending",
      "description": "Booking request status"
    }
  },
  "required": [
    "vendor_id",
    "user_id",
    "event_date",
    "guest_count"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.vendor_id": {
            "$in": {
              "$query": {
                "entity": "Vendor",
                "field": "id",
                "filter": {
                  "data.user_id": "{{user.id}}"
                }
              }
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.vendor_id": {
            "$in": {
              "$query": {
                "entity": "Vendor",
                "field": "id",
                "filter": {
                  "data.user_id": "{{user.id}}"
                }
              }
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.vendor_id": {
            "$in": {
              "$query": {
                "entity": "Vendor",
                "field": "id",
                "filter": {
                  "data.user_id": "{{user.id}}"
                }
              }
            }
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}