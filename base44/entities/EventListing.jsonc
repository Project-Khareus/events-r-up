{
  "name": "EventListing",
  "properties": {
    "description": {
      "description": "Full description of the event",
      "type": "string"
    },
    "event_date": {
      "description": "Date and time of the event",
      "format": "date-time",
      "type": "string"
    },
    "image_url": {
      "description": "Cover image URL",
      "type": "string"
    },
    "is_paid": {
      "default": false,
      "description": "Whether the event is free or paid",
      "type": "boolean"
    },
    "is_recurring": {
      "default": false,
      "description": "Whether this is a recurring event",
      "type": "boolean"
    },
    "location_address": {
      "description": "Text address of the location",
      "type": "string"
    },
    "location_lat": {
      "description": "Latitude for map pin",
      "maximum": 90,
      "minimum": -90,
      "type": "number"
    },
    "location_lng": {
      "description": "Longitude for map pin",
      "maximum": 180,
      "minimum": -180,
      "type": "number"
    },
    "organizer_name": {
      "description": "Name of the event organizer or organization",
      "type": "string"
    },
    "price": {
      "description": "Price if paid",
      "type": "number"
    },
    "recurrence_end_date": {
      "description": "When the recurring event series ends",
      "format": "date-time",
      "type": "string"
    },
    "recurrence_frequency": {
      "description": "Frequency of recurrence",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "custom"
      ],
      "type": "string"
    },
    "recurrence_pattern": {
      "description": "Custom recurrence pattern (e.g., 'Every Monday and Wednesday')",
      "type": "string"
    },
    "slug": {
      "description": "URL-friendly unique identifier derived from the event title, used for shareable /event/{slug} links",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "description": "Approval status of the event",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "type": "string"
    },
    "theme": {
      "default": "Other",
      "description": "Event theme/category",
      "enum": [
        "Music",
        "Food & Drink",
        "Business",
        "Arts & Culture",
        "Sports",
        "Community",
        "Party",
        "Education",
        "Other"
      ],
      "type": "string"
    },
    "title": {
      "description": "Title of the event",
      "type": "string"
    },
    "user_id": {
      "description": "ID of the user who posted the event",
      "type": "string"
    }
  },
  "required": [
    "title",
    "location_address",
    "event_date",
    "theme"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}