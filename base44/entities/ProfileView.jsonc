{
  "name": "ProfileView",
  "type": "object",
  "properties": {
    "vendor_id": {
      "type": "string"
    },
    "viewer_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "vendor_id",
    "viewer_id",
    "date"
  ],
  "rls": {
    "create": {
      "data.viewer_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}